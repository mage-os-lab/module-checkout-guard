<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magento\Framework\Webapi\Rest\RequestValidatorInterface">
        <plugin name="mageos_checkout_guard_rest_payment_routes" type="MageOS\CheckoutGuard\Plugin\Webapi\BlockPaymentRoutes" sortOrder="1"/>
    </type>
    <type name="MageOS\CheckoutGuard\Plugin\Webapi\BlockPaymentRoutes">
        <arguments>
            <argument name="blockedPathPatterns" xsi:type="array">
                <item name="cart_payment_routes" xsi:type="string"><![CDATA[#^/V1/(guest-carts/[^/]+|carts/mine)/(payment-information|order|set-payment-information|selected-payment-method)$#]]></item>
            </argument>
        </arguments>
    </type>
</config>
