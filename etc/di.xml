<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <virtualType name="MageOS\CheckoutGuard\Logger\Handler" type="Magento\Framework\Logger\Handler\Base">
        <arguments>
            <argument name="fileName" xsi:type="string">var/log/checkout_guard.log</argument>
        </arguments>
    </virtualType>
    <virtualType name="MageOS\CheckoutGuard\Logger" type="Magento\Framework\Logger\Monolog">
        <arguments>
            <argument name="name" xsi:type="string">checkout_guard</argument>
            <argument name="handlers" xsi:type="array">
                <item name="info" xsi:type="object">MageOS\CheckoutGuard\Logger\Handler</item>
            </argument>
        </arguments>
    </virtualType>
    <type name="MageOS\CheckoutGuard\Plugin\Quote\PaymentFailureGuard">
        <arguments>
            <argument name="logger" xsi:type="object">MageOS\CheckoutGuard\Logger</argument>
        </arguments>
    </type>
    <type name="Magento\Quote\Model\QuoteManagement">
        <plugin name="mageos_checkout_guard_payment_failures" type="MageOS\CheckoutGuard\Plugin\Quote\PaymentFailureGuard"/>
    </type>
</config>
